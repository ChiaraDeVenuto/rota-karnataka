# Rota Karnataka — no required environment variables.
# The app builds and runs with these empty: no API keys, no runtime cost.
#
# Optional entries reserved for future work (fall back to sane defaults when empty):

# LLM provider for dynamic stop descriptions (default: off)
VITE_LLM_API_KEY=

# Tile server instead of OpenStreetMap (default: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png)
VITE_TILE_URL=

# Budget tolerance percentage before the over-budget warning (default: 100 = disabled)
VITE_BUDGET_TOLERANCE=
